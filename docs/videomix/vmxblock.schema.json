                        "type": "string",
                        "enum": [
                          "start",
                          "end"
                        ]
                      },
                      "offset": {
                        "type": "number",
                        "description": "Seconds, may be negative"
                      }
                    },
                    "required": [
                      "kind",
                      "elementId",
                      "edge",
                      "offset"
                    ]
                  }
                ]
              },
              "type": {
                "type": "string",
                "const": "countdown"
              },
              "duration": {
                "type": "number"
              },
              "box": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ]
              },
              "align": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              },
              "decimals": {
                "type": "number",
                "enum": [
                  0,
                  1,
                  2,
                  3
                ]
              },
              "leadingZeros": {
                "type": "boolean"
              },
              "color": {
                "type": "string",
                "pattern": "^#[\\da-f]{6}([\\da-f]{2})?$"
              },
              "font": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Relative to the .vmxblock file (with \"/\" separators), or absolute"
                  }
                },
                "required": [
                  "path"
                ]
              },
              "border": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[\\da-f]{6}([\\da-f]{2})?$"
                  }
                },
                "required": [
                  "width",
                  "color"
                ]
              },
              "shadow": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[\\da-f]{6}([\\da-f]{2})?$"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "color"
                ]
              },
              "fadeOut": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "name",
              "anchor",
              "type",
              "duration",
              "box",
              "align",
              "decimals",
              "leadingZeros",
              "color",
              "border",
              "fadeOut"
            ]
          },
